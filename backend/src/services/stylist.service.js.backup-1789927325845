function colorCompatibility(
  colorA,
  colorB
) {
  const a = normalize(colorA);
  const b = normalize(colorB);

  if (!a || !b) {
    return 5;
  }

  if (a === b) {
    return -5;
  }

  if (
    COLOR_RULES[a]?.includes(b) ||
    COLOR_RULES[b]?.includes(a)
  ) {
    return 20;
  }

  return 0;
}


/* =========================================================
   OCCASION / FORMALITY SUITABILITY
   ========================================================= */

function suitabilityScore(
  candidate,
  outfitItems = [],
  context = {}
) {
  let score = 0;

  const candidateText =
    getItemText(candidate);

  const occasion =
    normalize(context.occasion);

  const style =
    normalize(context.style);


  /* -------------------------------------------------------
     Occasion signals
     ------------------------------------------------------- */

  if (occasion) {
    if (
      candidateText.includes(occasion)
    ) {
      score += 20;
    }

    if (
      occasion === "college" &&
      (
        candidateText.includes("casual") ||
        candidateText.includes("everyday") ||
        candidateText.includes("daily")
      )
    ) {
      score += 12;
    }

    if (
      occasion === "office" &&
      (
        candidateText.includes("formal") ||
        candidateText.includes("office") ||
        candidateText.includes("business")
      )
    ) {
      score += 15;
    }

    if (
      occasion === "wedding" &&
      (
        candidateText.includes("formal") ||
        candidateText.includes("wedding") ||
        candidateText.includes("party") ||
        candidateText.includes("ethnic") ||
        candidateText.includes("traditional")
      )
    ) {
      score += 15;
    }

    if (
      occasion === "party" &&
      (
        candidateText.includes("party") ||
        candidateText.includes("casual") ||
        candidateText.includes("smart")
      )
    ) {
      score += 10;
    }
  }


  /* -------------------------------------------------------
     Style signals
     ------------------------------------------------------- */

  if (style) {
    if (
      candidateText.includes(style)
    ) {
      score += 15;
    }

    if (
      style === "casual" &&
      (
        candidateText.includes("casual") ||
        candidateText.includes("everyday")
      )
    ) {
      score += 10;
    }

    if (
      style === "formal" &&
      (
        candidateText.includes("formal") ||
        candidateText.includes("business")
      )
    ) {
      score += 10;
    }

    if (
      style === "streetwear" &&
      (
        candidateText.includes("street") ||
        candidateText.includes("oversized") ||
        candidateText.includes("sneaker")
      )
    ) {
      score += 10;
    }
  }


  /* -------------------------------------------------------
     Color compatibility with already selected items.
     ------------------------------------------------------- */

  const candidateColor =
    getItemColor(candidate);

  for (const outfitItem of outfitItems) {
    const outfitColor =
      getItemColor(outfitItem);

    score += colorCompatibility(
      candidateColor,
      outfitColor
    );
  }


  return score;
}


/* =========================================================
   CHECK WHETHER A WARDROBE ITEM IS ACTUALLY SUITABLE
   ========================================================= */

function isSuitableWardrobeItem(
  candidate,
  outfitItems = [],
  context = {}
) {
  if (!candidate) {
    return false;
  }


  const score =
    suitabilityScore(
      candidate,
      outfitItems,
      context
    );


  /*
   * If the candidate has no useful contextual
   * information, do not reject it automatically.
   *
   * The existing AI recommendation remains the
   * primary fashion reasoning layer.
   */

  const hasContextData =
    Boolean(
      candidate.style ||
      candidate.occasion ||
      candidate.formality ||
      candidate.details?.occasion ||
      candidate.details?.style
    );


  if (!hasContextData) {
    return true;
  }


  return score >= 0;
}


/* =========================================================
   OUTFIT REQUIREMENT ANALYSIS

   This is the core of dynamic missing-item detection.

   We do NOT say:
       "shoes are always missing"

   Instead we first inspect what the AI actually
   constructed and what the user's request requires.
   ========================================================= */

function determineRequiredRoles(
  outfitItems = [],
  context = {}
) {
  const roles = new Set();


  for (const item of outfitItems) {
    const role =
      getRoleFromOutfitItem(item);

    if (role) {
      roles.add(role);
    }
  }


  const hasDress =
    roles.has("dress");

  const hasTop =
    roles.has("top");

  const hasBottom =
    roles.has("bottom");

  const hasFootwear =
    roles.has("footwear");


  /* -------------------------------------------------------
     Dress outfits

     A dress replaces top + bottom.
     ------------------------------------------------------- */

  if (hasDress) {
    roles.delete("top");
    roles.delete("bottom");

    /*
     * A wearable outfit still needs footwear
     * unless the user specifically requested only
     * the dress itself.
     */
    if (
      !context.message ||
      !normalize(context.message).includes(
        "dress only"
      )
    ) {
      roles.add("footwear");
    }
  }


  /* -------------------------------------------------------
     Standard top + bottom outfit

     If the AI has produced a top and bottom,
     footwear is part of completing the outfit.
     ------------------------------------------------------- */

  if (
    hasTop &&
    hasBottom
  ) {
    roles.add("footwear");
  }


  /* -------------------------------------------------------
     Top-only / selected-item styling

     If the user specifically asks to style an item,
     we need to find compatible pieces around it.
     ------------------------------------------------------- */

  if (
    context.selectedItem &&
    roles.size <= 1
  ) {
    const selectedRole =
      getWardrobeRole(
        context.selectedItem
      );

    if (selectedRole === "top") {
      roles.add("bottom");
      roles.add("footwear");
    }

    if (selectedRole === "bottom") {
      roles.add("top");
      roles.add("footwear");
    }

    if (selectedRole === "dress") {
      roles.add("footwear");
    }
  }


  return Array.from(roles);
}


/* =========================================================
   DYNAMIC MISSING ITEM ANALYSIS

   IMPORTANT:

   We only call something "missing" when:

   1. The outfit actually requires it
   2. No suitable wardrobe item exists

   An arbitrary wardrobe category is NOT treated
   as missing.
   ========================================================= */

export function analyzeMissingItems({
  outfitItems = [],
  wardrobe = [],
  context = {},
}) {
  const requiredRoles =
    determineRequiredRoles(
      outfitItems,
      context
    );


  const selectedItems = [
    ...outfitItems,
  ];


  const missingItems = [];


  for (const role of requiredRoles) {

    /*
     * Does the AI already have an item for this role?
     */
    const outfitItem =
      outfitItems.find(
        (item) =>
          getRoleFromOutfitItem(item) ===
          role
      );


    if (outfitItem) {
      continue;
    }


    /*
     * Search the USER'S ACTUAL wardrobe
     * for this role.
     */
    const candidates =
      wardrobe.filter(
        (item) =>
          (
            item.wardrobeRole ||
            getWardrobeRole(item)
          ) === role
      );


    /*
     * Find the best suitable wardrobe candidate.
     */
    let bestCandidate = null;
    let bestScore = -Infinity;


    for (const candidate of candidates) {

      if (
        !isSuitableWardrobeItem(
          candidate,
          selectedItems,
          context
        )
      ) {
        continue;
      }


      const score =
        suitabilityScore(
          candidate,
          selectedItems,
          context
        );


      if (
        score > bestScore
      ) {
        bestScore = score;
        bestCandidate = candidate;
      }
    }


    /*
     * Suitable wardrobe item exists.
     *
     * Therefore this role is NOT missing.
     */
    if (bestCandidate) {
      selectedItems.push(
        bestCandidate
      );

      continue;
    }


    /*
     * No suitable wardrobe item exists.
     *
     * NOW — and only now — do we create
     * a missing item.
     */
    missingItems.push({
      role,

      title: getMissingItemTitle(
        role
      ),

      reason:
        `No suitable ${getRoleLabel(
          role
        )} was found in your wardrobe for this outfit.`,

      shoppingRequired:
        !context.wardrobeOnly,

      query: buildMissingItemQuery(
        role,
        selectedItems,
        context
      ),
    });
  }


  return {
    requiredRoles,
    missingItems,
    completedItems: selectedItems,
  };
}


/* =========================================================
   FRIENDLY ROLE LABEL
   ========================================================= */

function getRoleLabel(role) {
  const labels = {
    top: "top",
    bottom: "bottom",
    footwear: "footwear",
    dress: "dress",
    accessory: "accessory",
  };

  return labels[role] || "item";
}


/* =========================================================
   MISSING ITEM TITLE

   This does NOT decide whether something is missing.

   It only gives a human-readable title AFTER the
   analysis has determined the missing role.
   ========================================================= */

function getMissingItemTitle(role) {
  const titles = {
    top: "A suitable top",
    bottom: "A suitable bottom",
    footwear: "Suitable footwear",
    dress: "A suitable dress",
    accessory: "A suitable accessory",
  };

  return (
    titles[role] ||
    "A suitable item"
  );
}


/* =========================================================
   SHOPPING QUERY

   This is generated AFTER missing-item analysis.

   It is not used to decide what is missing.
   ========================================================= */

function buildMissingItemQuery(
  role,
  outfitItems = [],
  context = {}
) {
  const colors = outfitItems
    .map(getItemColor)
    .filter(Boolean);

  const color =
    colors.length > 0
      ? colors[0]
      : "";


  const occasion =
    normalize(context.occasion);

  const style =
    normalize(context.style);


  const roleNames = {
    top: "top",
    bottom: "bottom",
    footwear: "shoes",
    dress: "dress",
    accessory: "accessory",
  };


  return [
    color,
    roleNames[role] || "fashion item",
    style,
    occasion,
  ]
    .filter(Boolean)
    .join(" ");
}


/* =========================================================
   NORMALIZE AI OUTFIT
   ========================================================= */

function normalizeAiOutfit(
  aiRecommendation
) {
  const outfit =
    aiRecommendation?.outfit ||
    aiRecommendation;


  if (!outfit) {
    return null;
  }


  return {
    ...outfit,

    items: Array.isArray(
      outfit.items
    )
      ? outfit.items
      : [],

    missingItems: Array.isArray(
      outfit.missingItems
    )
      ? outfit.missingItems
      : [],
  };
}


/* =========================================================
   PRESERVE SELECTED ITEM

   If the user specifically selected a closet item,
   make sure it remains part of the final outfit.
   ========================================================= */

function ensureSelectedItem(
  outfitItems = [],
  selectedItem
) {
  if (!selectedItem) {
    return outfitItems;
  }


  const alreadyIncluded =
    outfitItems.some(
      (item) =>
        String(item?.id) ===
        String(selectedItem.id)
    );


  if (alreadyIncluded) {
    return outfitItems;
  }


  return [
    selectedItem,
    ...outfitItems,
  ];
}


/* =========================================================
   MAIN STYLIST FUNCTION
   ========================================================= */

export async function generateStylistRecommendation({
  closetItems = [],
  message = "",
  occasion = "casual",
  style = "casual",
  role = "Full Outfit",
  temperatureC = null,
  weatherCondition = "clear",
  budget = null,
  selectedItemId = null,
  wardrobeOnly = false,
}) {
  if (!Array.isArray(closetItems)) {
    throw new Error(
      "Invalid wardrobe data."
    );
  }


  if (!closetItems.length) {
    throw new Error(
      "Your closet is empty. Upload some clothes first."
    );
  }


  /* -------------------------------------------------------
     Prepare wardrobe
     ------------------------------------------------------- */

  const wardrobe =
    prepareWardrobe(
      closetItems
    );


  /* -------------------------------------------------------
     Selected item
     ------------------------------------------------------- */

     /* -------------------------------------------------------
   Selected / explicitly requested wardrobe item
   ------------------------------------------------------- */

let selectedItem = null;


/*
 * First respect an explicitly supplied wardrobe ID.
 */
if (selectedItemId) {
  selectedItem =
    closetItems.find(
      (item) =>
        String(item.id) ===
        String(selectedItemId)
    ) || null;
}


/*
 * Otherwise try to identify the actual wardrobe item
 * mentioned in the user's message.
 */
if (
  !selectedItem &&
  message
) {
  selectedItem =
    findSelectedWardrobeItem(
      closetItems,
      message
    );
}


/*
 * Extract the item phrase independently.
 *
 * Example:
 *
 * "Show me something with my black jeans"
 *
 * requestedItemText = "black jeans"
 */
const requestedItemText =
  extractExplicitWardrobeItemRequest(
    message
  );


/*
 * This means:
 *
 * The USER explicitly requested an item,
 * BUT that item was not found in the actual closet.
 *
 * This is NOT a hardcoded category check.
 */
const requestedItemMissing =
  Boolean(
    requestedItemText &&
    !selectedItem
  );

  /* -------------------------------------------------------
     Build request context
     ------------------------------------------------------- */

  const context =
    buildStylistContext({
      message,
      occasion,
      style,
      budget,
      selectedItem,
      wardrobeOnly,
    });

    /* -------------------------------------------------------
   EXPLICIT ITEM NOT FOUND

   If the user specifically asked for an item and that
   item does not exist in their current wardrobe, DO NOT
   let the general outfit generator create an unrelated
   outfit.

   The requested item itself becomes the missing item.

   This is dynamically derived from the user's message.
   ------------------------------------------------------- */

if (
  requestedItemMissing
) {
  const shoppingRequired =
    !context.wardrobeOnly;


  const missingItem = {
    title:
      requestedItemText,

    reason:
      `You specifically asked for "${requestedItemText}", but I couldn't find that item in your current wardrobe.`,

    shoppingRequired,

    query:
      requestedItemText,

    role: null,
  };


  return {
    success: true,

    message:
      `I couldn't find "${requestedItemText}" in your current wardrobe, so I didn't create a different outfit without it.`,

    intent: {
      type: "missing_requested_item",

      role,

      occasion:
        context.occasion,

      style:
        context.style,

      budget:
        context.budget,

      wardrobeOnly:
        context.wardrobeOnly,

      shoppingRequested:
        context.shoppingRequested,
    },

    context: {
      ...context,

      requestedItemText,

      requestedItemMissing: true,

      selectedItemId:
        null,
    },

    outfit: {
      items: [],

      missingItems: [
        missingItem,
      ],

      shoppingRequired,

      explanation:
        `I couldn't find "${requestedItemText}" in your current wardrobe.`,
    },
  };
}

  /* -------------------------------------------------------
     Call YOUR existing Python AI
     ------------------------------------------------------- */

  const aiRecommendation =
    await getAiRecommendation({
      closet: wardrobe,

      message:
        context.message,

      selectedItem:
        context.selectedItem,

      occasion:
        context.occasion,

      style:
        context.style,

      role,

      temperatureC,

      weatherCondition,
    });


  const outfit =
    normalizeAiOutfit(
      aiRecommendation
    );


  if (!outfit) {
    throw new Error(
      "I couldn't create an outfit from your wardrobe."
    );
  }


  /* -------------------------------------------------------
     Preserve selected closet item
     ------------------------------------------------------- */

  let outfitItems =
    ensureSelectedItem(
      outfit.items,
      selectedItem
    );


  /* -------------------------------------------------------
     Dynamic missing-item analysis
     ------------------------------------------------------- */

  const analysis =
    analyzeMissingItems({
      outfitItems,
      wardrobe,
      context,
    });


  /*
   * The AI may already have detected missing items.
   *
   * We keep them only when they contain a role that
   * our own outfit-specific analysis also confirms.
   *
   * This prevents old hard-coded AI/controller output
   * from automatically creating shopping requirements.
   */

  const confirmedRoles =
    new Set(
      analysis.missingItems.map(
        (item) =>
          normalize(
            item.role
          )
      )
    );


  const aiMissingItems =
    outfit.missingItems.filter(
      (item) =>
        confirmedRoles.has(
          normalize(
            item?.role ||
            item?.category
          )
        )
    );


  /*
   * Our dynamic analysis is the source of truth.
   */
  const missingItems =
    analysis.missingItems.map(
      (item) => {

        const aiItem =
          aiMissingItems.find(
            (existing) =>
              normalize(
                existing?.role ||
                existing?.category
              ) ===
              normalize(item.role)
          );


        return {
          ...item,

          /*
           * Preserve useful AI information if available.
           */
          ...(aiItem || {}),

          role:
            item.role,

          title:
            item.title,

          reason:
            item.reason,

          query:
            item.query,

          shoppingRequired:
            !context.wardrobeOnly,
        };
      }
    );


  /* -------------------------------------------------------
     Do not allow selected item to disappear.
     ------------------------------------------------------- */

  if (
    selectedItem &&
    !outfitItems.some(
      (item) =>
        String(item?.id) ===
        String(selectedItem.id)
    )
  ) {
    outfitItems = [
      selectedItem,
      ...outfitItems,
    ];
  }


  /* -------------------------------------------------------
     Shopping decision
     ------------------------------------------------------- */

  const shoppingRequired =
    missingItems.length > 0 &&
    !context.wardrobeOnly;


  /* -------------------------------------------------------
     User-facing explanation
     ------------------------------------------------------- */

  let explanation =
    outfit.explanation ||
    "";


  if (!explanation) {

    if (
      missingItems.length === 0
    ) {
      explanation =
        "I found a complete outfit using suitable pieces from your wardrobe.";
    } else {

      const labels =
        missingItems.map(
          (item) =>
            getRoleLabel(
              item.role
            )
        );


      explanation =
        `I used the suitable pieces from your wardrobe. ` +
        `Your outfit still needs ${labels.join(
          " and "
        )} to be complete.`;
    }
  }


  /* -------------------------------------------------------
     Final result
     ------------------------------------------------------- */

  return {
    success: true,

    message:
      missingItems.length > 0
        ? `I've built the best outfit I can from your wardrobe and identified what is actually missing.`
        : `I've built a complete outfit from your wardrobe.`,

    intent: {
      type: "style_outfit",

      role,

      occasion:
        context.occasion,

      style:
        context.style,

      budget:
        context.budget,

      wardrobeOnly:
        context.wardrobeOnly,

      shoppingRequested:
        context.shoppingRequested,
    },

    context: {
      ...context,

      selectedItemId:
        selectedItem?.id ||
        null,
    },

    outfit: {
      ...outfit,

      items:
        analysis.completedItems,

      missingItems,

      shoppingRequired,

      explanation,
    },
  };
}


